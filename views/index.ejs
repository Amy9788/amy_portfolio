<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="/assets/favicon.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="preload" href="/assets/img/hero_section_bg.webp" as="image">
    <title>Amy's Portfolio</title>

    <!-- SEO -->
    <meta property="og:image" content="https://designwithamy.com/assets/logo.svg">
    <meta property="og:image:width" content="500">
    <meta property="og:image:height" content="500">
    <meta property="og:image:type" content="image/webp">
    <meta name="description" content="Amy is a Web designer and a Web developer, creating functional, responsive, and elegant websites for businesses and individuals.">
    <meta name="title" content="Amy - Web Designer & Developer | Custom Websites">
    <meta property="og:url" content="https://jirehrecycle.com">
    <meta property="og:title" content="Amy - Web Designer & Developer | Custom Websites">
    <meta property="og:description" content="Amy is a Web designer and a Web developer, creating functional, responsive, and elegant websites for businesses and individuals.">

</head>
<body>
    <%- include('partials/nav') %>
    <header class="header sm-padding md-margin-bottom">
        <div class="header__text_box md-padding">
            <h1 class="heading-primary">
                <span class="heading-primary__part1">
                    Hi, I'm Amy,
                </span>
                <span class="heading-primary__part2"> Web designer</span>
                <span class="heading-primary__part3">and Web developer</span>
            </h1>
            <div class="heading-passage">
                I build functional and elegant websites for individuals and businesses. 
                If you are in need of a website, please reach out to me and we can discuss your needs.
            </div>
            <a href="#projects" class="btn btn__green">Projects</a>
        </div>
    </header>
    <main class="main md-padding">
        <section class="section-projects md-margin-bottom" id="projects">
            <% for (let key in projects_data["projects"]) { %>
                <div class="section-projects__item">
                    <div class="section-projects__item-left">
                        <p class="heading-tertiary">
                            <%= projects_data["projects"][key].name %>
                        </p>
                        <h2 class="heading-secondary">
                            <span class="heading-secondary__part1">
                                <%= projects_data["projects"][key].heading_secondary__part1 %>
                            </span>
                            <span class="heading-secondary__part2">
                                <%= projects_data["projects"][key].heading_secondary__part2 %>
                            </span>
                        </h2>
                        <p class="paragraph paragraph-black md-width">
                            <%= projects_data["projects"][key].desc %>
                        </p>
                        <div class="mobile-item sm-margin-top">
                            <img src="<%= projects_data["projects"][key].img_src %>" width="500" height="480" class="project-img" alt="<%= projects_data["projects"][key].alt %>"/>
                        </div>
                        <a href="/projects/project<%= projects_data["projects"][key].number%>" class="btn btn__green">
                            <%= projects_data["projects"][key].btn_type %>
                        </a>
                    </div>
                    <div class="section-projects__item-right">
                        <img src=" <%= projects_data["projects"][key].img_src %>" width="1000" height="800" class="project-img" alt="<%= projects_data["projects"][key].alt %>"/>
                    </div>
                </div>
            <% } %>
        </section>
        <section class="section-about md-margin-bottom" id="about-me">
            <p class="heading-quaternary">
                <span>What</span>&nbsp;
                <span class="heading-quaternary__color-part"> I do</span>
            </p>
            <div class="section-about__content">
               <div class="section-about__item">
                   <div class="section-about__item-icon">
                        <img src="/assets/icon/design_icon.svg" alt="design icon" width="100" height="100"/>
                   </div>
                   <div class="section-about__item-text">
                        <p class="heading-quinary">Designs</p>
                        <p class="paragraph paragraph-sm md-width">
                            Websites are the front faces of businesses. 
                            We can work together to create a site that will 
                            capture customers attention and bring your vision into life.
                        </p>
                   </div>
               </div>

               <div class="section-about__item">
                    <div class="section-about__item-icon">
                        <img src="/assets/icon/code_icon.svg" alt="coding icon" width="100" height="100"/>
                    </div>
                    <div class="section-about__item-text">
                        <p class="heading-quinary">Web Development</p>
                        <p class="paragraph paragraph-sm md-width">
                            With my experience and expertise of building websites from scratch 
                            or with the help of Webflow, I am excited to help launch your business website. 
                            Following my services, you will be given access to edit your site with ease, 
                            giving you control over your desired designs.
                        </p>
                    </div>
                </div>
            </div>
        </section>
        <%- include('partials/contact') %>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/index.js" defer></script>
</body>
</html>